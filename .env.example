# Copy to .env and fill in locally. Never commit .env.
# Supabase: Project Settings → Database → Connection string.

# Runtime connection used by the app (Supabase pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# Direct/session connection used by the Prisma CLI (db pull, migrate diff).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Set to "false" to disable public sign-up.
ALLOW_SIGNUP="true"

# Bearer secret for GET /api/cron/work (32+ random characters). Empty = endpoint disabled.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Integration tests only — must point at a LOCAL database (e.g. `npx prisma dev`).
# TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51214/upsitehealth_test?sslmode=disable"

# Optional integrations — leave empty to disable.
# PageSpeed works without a key at low volume; a key raises Google's limits.
PAGESPEED_API_KEY=""
# AI Search providers (the Mock provider is always available).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
PERPLEXITY_API_KEY=""
PERPLEXITY_PRESET="fast"
# Email notifications via Resend (both required). Empty = deliveries recorded as NOT_CONFIGURED.
RESEND_API_KEY=""
EMAIL_FROM=""
# Public base URL for links in emails, e.g. https://app.example.com
APP_URL=""
