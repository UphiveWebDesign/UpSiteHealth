# Copy to .env and fill in locally. Never commit .env.
# Supabase: Project Settings → Database → Connection string.

# Runtime connection used by the app (Supabase pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# Direct/session connection used by the Prisma CLI (db pull, migrate diff).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Set to "false" to disable public sign-up.
ALLOW_SIGNUP="true"

# Integration tests only — must point at a LOCAL database (e.g. `npx prisma dev`).
# TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51214/upsitehealth_test?sslmode=disable"
